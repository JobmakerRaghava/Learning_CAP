COLUMN TABLE poc_db_EmployeeDetails (
  ID NVARCHAR(36) NOT NULL,
  createdAt TIMESTAMP,
  createdBy NVARCHAR(255),
  modifiedAt TIMESTAMP,
  modifiedBy NVARCHAR(255),
  DELETE NVARCHAR(5000) DEFAULT 'X',
  EmpID INTEGER,
  FirstName NVARCHAR(50),
  LastName NVARCHAR(50),
  Age INTEGER,
  Position NVARCHAR(50),
  Email NVARCHAR(50),
  status NVARCHAR(10),
  PRIMARY KEY(ID)
)